{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error"
	},
	"env": {
		"browser": true,
		"node": true,
		"svelte": true
	},
	"rules": {
		"no-unused-vars": [
			"error",
			{
				"args": "all",
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_"
			}
		]
	},
	"overrides": [
		{
			"files": ["**/*.svelte"],
			"rules": {
				"no-unassigned-vars": "off"
			}
		}
	]
}
