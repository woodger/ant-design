{
  "name": "@local/ant-design-svelte",
  "version": "0.1.0",
  "private": true,
  "description": "Community port of Ant Design primitives to Svelte 5 and TypeScript",
  "type": "module",
  "license": "MIT",
  "svelte": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "svelte": "./index.ts",
      "default": "./index.ts"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "*.svelte",
    "*.ts",
    "!*.test.ts",
    "*.css",
    "vendor"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "svelte": "^5.57.1",
    "dayjs": "^1.11.11"
  }
}
