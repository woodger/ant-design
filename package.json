{
  "name": "antd-svelte",
  "version": "0.1.0",
  "private": true,
  "description": "Ant Design components for Svelte 5 with TypeScript and API compatibility",
  "homepage": "https://woodger.org/ant-design",
  "keywords": [
    "antd",
    "ant-design",
    "svelte",
    "svelte5",
    "typescript",
    "components",
    "ui"
  ],
  "type": "module",
  "license": "MIT",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./porting/registry.json": "./docs/reference/ant-design-porting/registry.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "docs/reference/ant-design-porting/registry.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "dayjs": "^1.11.11",
    "svelte": "^5.57.1"
  },
  "scripts": {
    "build": "svelte-package",
    "dev": "svelte-package --watch",
    "lint": "oxlint src tests tools vite.config.ts svelte.config.js playwright.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "test": "vitest run",
    "cli": "node tools/cli.mjs",
    "check:tests": "npm run build && svelte-check --tsconfig ./tests/tsconfig.json",
    "test:package": "npm run build && vitest run --config tests/package/vite.config.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.9.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dayjs": "1.11.23",
    "icore": "3.0.1",
    "oxlint": "1.86.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "devalue": "^5.9.1",
    "vitest": {
      "vite": "^7.3.6"
    },
    "postcss": "^8.5.18"
  }
}
